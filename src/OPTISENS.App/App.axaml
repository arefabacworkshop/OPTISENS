<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OPTISENS.App.ViewModels"
             xmlns:views="using:OPTISENS.App.Views"
             x:Class="OPTISENS.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="CanvasVoidColor">#090A0D</Color>
    <Color x:Key="SurfaceCardColor">#12151B</Color>
    <Color x:Key="SurfaceElevatedColor">#1C1F26</Color>
    <Color x:Key="SurfaceControlColor">#262B35</Color>
    <Color x:Key="BorderSubtleColor">#242832</Color>
    <Color x:Key="BorderFocusedColor">#3B4252</Color>
    <Color x:Key="TextPrimaryColor">#F4F6F8</Color>
    <Color x:Key="TextMutedColor">#8E97A6</Color>
    <Color x:Key="TextDimColor">#525A68</Color>
    <Color x:Key="AccentCyanColor">#00F0FF</Color>
    <Color x:Key="AccentAmberColor">#FFB03A</Color>
    <Color x:Key="DangerRedColor">#FF4B4B</Color>

    <SolidColorBrush x:Key="CanvasVoidBrush" Color="{StaticResource CanvasVoidColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SurfaceControlBrush" Color="{StaticResource SurfaceControlColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="{StaticResource BorderFocusedColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window, UserControl">
      <Setter Property="FontFamily" Value="fonts:Inter#Inter, Segoe UI, Inter, Sans-Serif"/>
      <Setter Property="Foreground" Value="#F4F6F8"/>
    </Style>

    <Style Selector="TextBlock.tabular">
      <Setter Property="FontFeatures" Value="tnum=1"/>
    </Style>

    <Style Selector="TextBlock.mono-tabular">
      <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, SF Mono, Consolas, monospace"/>
      <Setter Property="FontFeatures" Value="tnum=1"/>
    </Style>

    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.6"/>
      <Setter Property="Foreground" Value="#8E97A6"/>
    </Style>

    <Style Selector="TextBlock.chat-prose">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="LineHeight" Value="21"/>
      <Setter Property="Foreground" Value="#E6EAF0"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="#242832"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#262B35"/>
      <Setter Property="Foreground" Value="#F4F6F8"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="#3B4252"/>
      <Setter Property="Background" Value="#2E3440"/>
    </Style>

    <Style Selector="Button.cta">
      <Setter Property="Background" Value="#F4F6F8"/>
      <Setter Property="Foreground" Value="#090A0D"/>
      <Setter Property="BorderBrush" Value="#F4F6F8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.cta:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#00F0FF"/>
      <Setter Property="Foreground" Value="#090A0D"/>
      <Setter Property="BorderBrush" Value="#00F0FF"/>
    </Style>

    <Style Selector="TextBox, NumericUpDown, ComboBox">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="BorderBrush" Value="#242832"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#262B35"/>
      <Setter Property="Foreground" Value="#F4F6F8"/>
    </Style>
    <Style Selector="TextBox:focus-within, NumericUpDown:focus-within, ComboBox:focus-within">
      <Setter Property="BorderBrush" Value="#3B4252"/>
    </Style>
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
      <views:SetupView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HardwareProfileViewModel}">
      <views:HardwareProfileView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionViewModel}">
      <views:CalibrationSessionView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
      <views:ResultsDashboardView/>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
