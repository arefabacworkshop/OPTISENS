<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
    <DefineConstants Condition="'$(Configuration)' == 'Debug'">$(DefineConstants);OPTISENS_DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OPTISENS.Core\OPTISENS.Core.csproj" />
    <ProjectReference Include="..\OPTISENS.Ai\OPTISENS.Ai.csproj" />
    <ProjectReference Include="..\OPTISENS.Platform\OPTISENS.Platform.csproj" />
    <ProjectReference Include="..\OPTISENS.Input.Windows\OPTISENS.Input.Windows.csproj" />
    <ProjectReference Include="..\OPTISENS.Input.Linux\OPTISENS.Input.Linux.csproj" />
    <ProjectReference Include="..\OPTISENS.Input.Mac\OPTISENS.Input.Mac.csproj" />
  </ItemGroup>
</Project>
