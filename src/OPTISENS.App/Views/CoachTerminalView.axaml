<UserControl x:Class="OPTISENS.App.Views.CoachTerminalView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OPTISENS.App.ViewModels"
             x:DataType="vm:CoachViewModel"
             x:CompileBindings="True">
  <Border Classes="card" Padding="18">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
        <TextBlock Grid.Column="0"
                   Text="AI COACH" Classes="eyebrow" VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Command="{Binding ToggleBackendCommand}"
                IsVisible="{Binding IsLocalAiMode}"
                IsEnabled="{Binding !IsBusy}"
                Background="#1C2530" BorderBrush="#2A3A4A" BorderThickness="1"
                CornerRadius="4" Padding="9,3"
                ToolTip.Tip="Click to toggle between CPU (Eco) and DirectML GPU">
          <TextBlock Text="{Binding ProviderBadge}" Classes="mono-tabular"
                     FontSize="10.5" Foreground="#00F0FF"/>
        </Button>
        <Border Grid.Column="1"
                IsVisible="{Binding !IsLocalAiMode}"
                Background="#1C2530" BorderBrush="#2A3A4A" BorderThickness="1"
                CornerRadius="4" Padding="9,3">
          <TextBlock Text="{Binding ProviderBadge}" Classes="mono-tabular"
                     FontSize="10.5" Foreground="#00F0FF"/>
        </Border>
        <Button Grid.Column="2"
                Command="{Binding UnloadModelCommand}"
                IsVisible="{Binding IsModelLoaded}"
                Background="#1C1F26" BorderBrush="#2A303D" BorderThickness="1"
                CornerRadius="4" Padding="9,3"
                ToolTip.Tip="Unload the AI model from RAM now; reloads automatically on your next message">
          <TextBlock Text="FREE RAM" Classes="mono-tabular"
                     FontSize="10.5" Foreground="#8E97A6"/>
        </Button>
        <Button Grid.Column="3"
                Command="{Binding ConfigureAiCommand}"
                Background="#1C1F26" BorderBrush="#2A303D" BorderThickness="1"
                CornerRadius="4" Padding="9,3"
                ToolTip.Tip="Configure AI Coach provider or disable AI">
          <TextBlock Text="AI SETTINGS" Classes="mono-tabular"
                     FontSize="10.5" Foreground="#8E97A6"/>
        </Button>
      </Grid>

      <TextBlock DockPanel.Dock="Top"
                 Text="{Binding StatusBanner}"
                 IsVisible="{Binding StatusBanner, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="#FFB03A" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10"/>

      <Border DockPanel.Dock="Bottom" Classes="card" Padding="16" Margin="0,8,0,0"
              IsVisible="{Binding IsAiDisabled}">
        <StackPanel Spacing="10">
          <TextBlock Text="AI COACH IS OFF" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"/>
          <TextBlock Text="Calibration works fully without AI. Opt in anytime for a results walkthrough — nothing is downloaded unless you choose to."
                     TextWrapping="Wrap" FontSize="12"
                     Foreground="{StaticResource TextSecondaryBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="secondary" Content="Connect Custom API (URL + Key)"
                    Command="{Binding ConfigureApiAiCommand}" Padding="12,7"/>
            <Button Classes="secondary" Content="Download Local AI (~1.66 GB)"
                    Command="{Binding ConfigureLocalAiCommand}" Padding="12,7"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0"
            IsVisible="{Binding !IsAiDisabled}">
        <TextBox Grid.Column="0" Text="{Binding InputText}"
                 FontSize="13" Padding="10,8"
                 PlaceholderText="Ask the coach… e.g. &quot;make it 5% slower&quot;">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SendCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Margin="8,0,0,0" Padding="16,8"/>
      </Grid>

      <ScrollViewer x:Name="TranscriptScroll" MaxHeight="260" Padding="0,0,8,0">
        <ItemsControl ItemsSource="{Binding Transcript}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatLine">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                         Classes="chat-prose"
                         Foreground="{Binding Brush}" Margin="0,6"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
