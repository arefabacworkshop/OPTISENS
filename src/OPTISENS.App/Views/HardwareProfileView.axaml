<UserControl x:Class="OPTISENS.App.Views.HardwareProfileView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OPTISENS.App.ViewModels"
             x:DataType="vm:HardwareProfileViewModel"
             x:CompileBindings="True">
  <Grid Background="#090A0D">
    <Border Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#12151B"
            BorderBrush="#242832"
            BorderThickness="1"
            CornerRadius="8"
            Padding="32">
      <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="avares://OPTISENS.App/Assets/logo-512.png" Width="36" Height="36"/>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="OPTISENS" FontSize="13" FontWeight="Bold" LetterSpacing="2.2" Foreground="#00F0FF"/>
            <TextBlock Text="AI-Assisted Sensitivity Finder" FontSize="11" Foreground="#525A68"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Text="Hardware Profile" FontSize="26" FontWeight="SemiBold" Foreground="#F4F6F8"/>
          <TextBlock Text="OPTISENS measures your optimal cm/360 — physical turn distance. Enter your hardware exactly."
                     TextWrapping="Wrap" FontSize="13" Foreground="#8E97A6"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Mouse DPI" FontSize="12" Foreground="#8E97A6"/>
          <NumericUpDown Value="{Binding Dpi}" Minimum="100" Maximum="6400" Increment="50" FormatString="0"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Mousepad usable width (cm)" FontSize="12" Foreground="#8E97A6"/>
          <NumericUpDown Value="{Binding PadWidthCm}" Minimum="5" Maximum="120" Increment="1" FormatString="0.0"/>
          <TextBlock Text="{Binding BoundsHintText}" Classes="mono-tabular"
                     FontSize="11" Foreground="#525A68"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Grip style" FontSize="12" Foreground="#8E97A6"/>
          <ComboBox ItemsSource="{Binding GripStyles}" SelectedItem="{Binding SelectedGrip}" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Interactive Pre-Session DPI & Raw Input Check -->
        <Border Background="#0E1117" BorderBrush="#242832" BorderThickness="1" CornerRadius="6" Padding="12,10">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="INPUT &amp; DPI CHECK" FontSize="10" FontWeight="SemiBold"
                         LetterSpacing="1.4" Foreground="#8E97A6" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Reset" Command="{Binding ResetInputTestCommand}"
                      IsVisible="{Binding IsTestingInput}" Padding="8,4" FontSize="11"/>
              <Button Grid.Column="2" Content="{Binding InputTestButtonText}" Command="{Binding ToggleInputTestCommand}"
                      Padding="10,4" FontSize="11"/>
            </Grid>
            <TextBlock Text="{Binding InputTestReadout}" Classes="mono-tabular"
                       FontSize="11" Foreground="#00F0FF" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding ValidationError}"
                   IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="#FF4B4B" FontSize="12" TextWrapping="Wrap"/>

        <Button Content="Start calibration"
                Command="{Binding StartCalibrationCommand}"
                Classes="cta"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12"/>

        <Button Command="{Binding ExitAppCommand}"
                Background="Transparent" BorderThickness="0"
                HorizontalAlignment="Center" Padding="4,2">
          <TextBlock Text="[ESC] Exit Application" Classes="mono-tabular"
                     FontSize="11" Foreground="#525A68"/>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
